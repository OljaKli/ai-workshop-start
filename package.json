{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node --test tests/e2e.ts",
    "test:browser": "node --test tests/browser.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node .agents/skills/demo-video/record.ts",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts",
    "e2e:linux": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
